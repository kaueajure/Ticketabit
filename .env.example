# MySQL da Hostinger (hPanel > Bancos de dados > Bancos MySQL)
DB_HOST=seu_host_mysql
DB_PORT=3306
DB_USER=seu_usuario_mysql
DB_NAME=seu_banco_mysql
DB_PASSWORD=sua_senha_mysql
DB_SSL=false

# Use uma sequência aleatória com pelo menos 32 caracteres.
AUTH_SECRET=gere_uma_chave_aleatoria_com_32_ou_mais_caracteres

# Pasta persistente irmã de public_html. Também pode ser um caminho absoluto.
UPLOADS_DIR=../uploads

# Chave compartilhada já incorporada à extensão interna.
EXTENSION_API_KEY=1544752770fcf0c0951fe2e021b8a60813789f0c199d67695b6a7f9395765250
EXTENSION_DEFAULT_CATEGORY=Suporte
EXTENSION_DEFAULT_STATUS=Não iniciado

# Integração oficial somente leitura com o histórico de tickets do Movidesk.
# Gere o token em Configurações > Conta > Parâmetros no Movidesk.
MOVIDESK_API_TOKEN=
MOVIDESK_API_URL=https://api.movidesk.com/public/v1
